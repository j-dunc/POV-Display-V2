##############################################################################
firmware/esp32-ui/build/
firmware/esp32-ui/managed_components/
firmware/esp32-ui/dependencies.lock
firmware/esp32-ui/sdkconfig
firmware/esp32-ui/sdkconfig.old
firmware/esp32-ui/**/*.d
firmware/esp32-ui/.mypy_cache/

# ESP-IDF size/log artifacts
*.map
*.wroom

