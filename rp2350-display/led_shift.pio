; Parallel LED-driver shift-clock generator.
; Shifts bits in OSR to out pins, taking exactly two SM cycles
; Pulses clk as data is shifted (using sideset)

.program led_shift_lhs
; out pins are GPIO 0-10. 5 and 9 are don't cares as they are never claimed by pio setup
.side_set 1

.wrap_target
    out pins, 11  side 1
    nop           side 0
.wrap

.program led_shift_rhs
; out pins are GPIO 21-29
.side_set 1

.wrap_target
    out pins, 9  side 1
    nop          side 0
.wrap
